{
    "$schema": "https://json.schemastore.org/template.json",
    "author": "Lê Minh Sơn",
    "classifications": [ "class" ],
    "shortName": "ONI Mod Template",
    "identity": "SonJeremy.Template",
    "groupIdentity": "SonJeremy.Template",
    "name": "Oxygen Not Included Mod Template",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "ModTemplate",
    "preferNameDirectory": true,
    "symbols": {
        "AskUsePLib": {
            "isRequired": true,
            "datatype": "bool",
            "type": "parameter",
            "defaultValue": "true",
            "displayName": "Use PLib"
        },
        "UsePLib": {
            "type": "computed",
            "value": "AskUsePLib == false"
        },
        "AskUseSModUtil": {
            "isRequired": true,
            "datatype": "bool",
            "type": "parameter",
            "defaultValue": "true",
            "displayName": "Use SModUtil"
        },
        "UseSModUtil": {
            "type": "computed",
            "value": "AskUseSModUtil == false"
        },
        "AskUsePublicized": {
            "isRequired": true,
            "datatype": "bool",
            "type": "parameter",
            "defaultValue": "false",
            "displayName": "Use Publicized"
        },
        "ModName": {
            "isRequired": true,
            "type": "parameter",
            "displayName": "Mod Name",
            "replaces": "TemplateName",
            "defaultValue": "TemplateName",
        },
        "ClassName": {
            "isRequired": true,
            "type": "parameter",
            "replaces": "ModTemplate",
            "defaultValue": "ModTemplate",
            "displayName": "Mod Class Name"
        },
        "ModVersion": {
            "isRequired": true,
            "type": "parameter",
            "replaces": "ModVersion",
            "defaultValue": "1.0.0.0",
            "displayName": "Mod Version"
        },
        "ModDescription": {
            "defaultValue": "",
            "type": "parameter",
            "replaces": "ModDescription",
            "displayName": "Mod Description"
        },
        "SupportedDLC": {
            "type": "parameter",
            "defaultValue": "ALL",
            "displayName": "Supported DLC",
            "replaces": "ModSupportedContent",
            "description": "Specify what DLC be supported (ALL, VANILLA_ID, EXPANSION1_ID, DLC2_ID, DLC3_ID)"
        },
        "LastWorkingBuild": {
            "isRequired": true,
            "type": "parameter",
            "defaultValue": "660455",
            "replaces": "ModLastWorkingBuild",
            "displayName": "Last Working Build",
            "description": "Minimum working game version (Ex: 651155)"
        },
        "BuildPlatform": {
            "isRequired": true,
            "type": "parameter",
            "datatype": "choice",
            "displayName": "Build Platform",
            "choices": [
                {
                    "choice": "All",
                    "displayName": "All Platform"
                },
                {
                    "choice": "Vanilla",
                    "displayName": "Vanilla Build Only"
                },
                {
                    "choice": "Mergedown",
                    "displayName": "SpacedOut & DLC Build Only"
                }
            ],
            "defaultValue": "All"
        },
        "IsBuildPlatformAll": {
            "type": "computed",
            "value": "BuildPlatform == All"
        },
        "IsBuildPlatformVanilla": {
            "type": "computed",
            "value": "BuildPlatform == Vanilla"
        },
        "IsBuildPlatformMergedown": {
            "type": "computed",
            "value": "BuildPlatform == Mergedown"
        },
        "AlwaysTrueHolder": {
            "type": "computed",
            "value": "(BuildPlatform == All || BuildPlatform == Vanilla || BuildPlatform == Mergedown)"
        }
    }
}